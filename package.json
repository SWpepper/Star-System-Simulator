{
  "name": "solar-system-simulator",
  "version": "1.1.0",
  "description": "恒星系模拟器 - 随机生成并模拟运行的 3D 恒星系",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "install:electron": "node scripts/install-electron.mjs",
    "start": "npm run install:electron && electron .",
    "preview": "vite preview",
    "clean:web": "rimraf dist/web",
    "build": "npm run build:web",
    "build:web": "npm run clean:web && vite build",
    "build:pages": "npm run build:web && node scripts/sync-pages.mjs",
    "build:electron": "npm run build:web && electron-builder --win",
    "test:electron": "npm run build:web && npm run install:electron && electron . --smoke-test",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"electron/**/*.cjs\" \"scripts/**/*.mjs\" \"*.config.js\" && prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\" \"electron/**/*.cjs\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{html,json,md}\"",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\" \"electron/**/*.cjs\" \"scripts/**/*.mjs\" \".github/**/*.yml\" \"*.{html,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "rimraf": "6.0.1",
    "three": "0.186.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.game.solar-system",
    "productName": "恒星系模拟器",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/web/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "恒星系模拟器"
    }
  }
}
